# Copy to .env.docker before starting Docker Compose.
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Public URLs used by the browser and employee agents.
# For local testing:
PUBLIC_BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# For production, use your HTTPS API and dashboard URLs instead.
# PUBLIC_BACKEND_URL=https://api.tracker.example.com
# ALLOWED_ORIGINS=https://tracker.example.com

BACKEND_PORT=8000
FRONTEND_PORT=8080
