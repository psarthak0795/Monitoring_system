# Copy to .env and fill in real values before running in production
#
# The port this backend listens on. This is the ONE place to change it if
# 8000 is already used by something else on a given machine — setup.bat
# reads this same value and keeps desktop-agent\.env and frontend\.env
# pointed at whatever you set here, on every machine, automatically. Never
# hardcode a different port directly in a script instead of here, or the
# agent/dashboard will silently fail to reach the backend.
PORT=8000
#
# SQLite is fine for one person testing locally. For a real organization
# rollout with many employees writing at once, switch to Postgres (avoids
# "database is locked" errors under concurrent writes):
# DATABASE_URL=sqlite:///./tracker.db
# DATABASE_URL=postgresql://user:password@localhost:5432/tracker
DATABASE_URL=sqlite:///./tracker.db
# For production, use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg2://tracker_user:strong-password@db:5432/tracker
# Legacy DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD variables remain
# supported for existing local installations.
 
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
 
# Where screenshots are stored on disk
SCREENSHOT_STORAGE_DIR=./storage/screenshots
 
# Comma-separated list of origins allowed to call this API. Leave as "*"
# only for local testing — once employee machines and the dashboard reach
# this backend over a real network, restrict it to your actual dashboard
# URL(s), e.g.:
#   ALLOWED_ORIGINS=https://tracker.yourcompany.com
ALLOWED_ORIGINS=*